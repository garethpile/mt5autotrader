    table.cell(setupTbl, 0, 2, "Scalp", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(setupTbl, 1, 2, str.tostring(scalpCount), text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(setupTbl, 2, 2, str.tostring(scalpWinPct, "#.0"), text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(setupTbl, 3, 2, str.tostring(scalpPnL, "#.00"), text_color=scalpPnL >= 0 ? color.lime : color.red, text_size=size.tiny, bgcolor=color.new(color.black, 85))

    table.cell(setupTbl, 0, 3, "Structure", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 85))
