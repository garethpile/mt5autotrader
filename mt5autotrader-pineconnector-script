    table.cell(setupTbl, 2, 3, str.tostring(structWinPct, "#.0"), text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(setupTbl, 3, 3, str.tostring(structPnL, "#.00"), text_color=structPnL >= 0 ? color.lime : color.red, text_size=size.tiny, bgcolor=color.new(color.black, 85))
else
    for r = 1 to 3
        for c = 0 to 3
            table.cell(setupTbl, c, r, "", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 100))

f_dbg_ok(_b) =>
    _b ? "OK" : "BLOCK"

f_dbg_col(_b) =>
    _b ? color.lime : color.red

f_gate_txt(_b) =>
    _b ? "OK" : "BLOCK"

var table gateTbl = table.new(position.bottom_center, 12, 3, frame_color=color.new(color.black, 70), frame_width=1)
if barstate.isfirst
    table.cell(gateTbl, 0, 0, "Side", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 1, 0, "canTrade", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 2, 0, "vol", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 3, 0, "S/R", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 4, 0, "MACD", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 5, 0, "RSI", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 6, 0, "Conf 3", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 7, 0, "Conf 4", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 8, 0, "Conf 5", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 9, 0, "Block 1", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 10, 0, "Block 2", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))
    table.cell(gateTbl, 11, 0, "Block 3", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 70))

showGateTable = showLongBlockDebug or showShortBlockDebug

if showGateTable
    // In this compact gate table, S/R reflects room-to-opposite-level.
    // Trigger/retest logic is tracked elsewhere in raw/confluence checks.
    longSROk = roomLongOk
    shortSROk = roomShortOk
    longMacdOk = longConfMacd
    shortMacdOk = shortConfMacd
    longRsiOk = longConfRsi
    shortRsiOk = shortConfRsi
    // Template status must represent template evidence only (separate from confluence adequacy).
    longTplOk = longTemplateEvidence
    shortTplOk = shortTemplateEvidence

    // Additional confluences (first 3 positives beyond S/R + MACD + RSI)
    string lConf3 = "BLOCK"
    string lConf4 = ""
    string lConf5 = ""
    int lConfHits = 0
    if longConfRegime
        lConfHits += 1
        if lConfHits == 1
            lConf3 := "Reg"
        else if lConfHits == 2
            lConf4 := "Reg"
        else if lConfHits == 3
            lConf5 := "Reg"
    if longConfStack
        lConfHits += 1
        if lConfHits == 1
            lConf3 := "Stack"
        else if lConfHits == 2
            lConf4 := "Stack"
        else if lConfHits == 3
            lConf5 := "Stack"
    if longConfPrice
        lConfHits += 1
        if lConfHits == 1
            lConf3 := "Price"
        else if lConfHits == 2
            lConf4 := "Price"
        else if lConfHits == 3
            lConf5 := "Price"
    if longConfStructure
        lConfHits += 1
        if lConfHits == 1
            lConf3 := "Struct"
        else if lConfHits == 2
            lConf4 := "Struct"
        else if lConfHits == 3
            lConf5 := "Struct"
    if longConfFvg
        lConfHits += 1
        if lConfHits == 1
            lConf3 := "FVG"
        else if lConfHits == 2
            lConf4 := "FVG"
        else if lConfHits == 3
            lConf5 := "FVG"
    if longConfAdx
        lConfHits += 1
        if lConfHits == 1
            lConf3 := "ADX"
        else if lConfHits == 2
            lConf4 := "ADX"
        else if lConfHits == 3
            lConf5 := "ADX"
    if longConfBias
        lConfHits += 1
        if lConfHits == 1
            lConf3 := "Bias"
        else if lConfHits == 2
            lConf4 := "Bias"
        else if lConfHits == 3
            lConf5 := "Bias"
    if longConfCtx
        lConfHits += 1
        if lConfHits == 1
            lConf3 := "Ctx"
        else if lConfHits == 2
            lConf4 := "Ctx"
        else if lConfHits == 3
            lConf5 := "Ctx"

    string sConf3 = "BLOCK"
    string sConf4 = ""
    string sConf5 = ""
    int sConfHits = 0
    if shortConfRegime
        sConfHits += 1
        if sConfHits == 1
            sConf3 := "Reg"
        else if sConfHits == 2
            sConf4 := "Reg"
        else if sConfHits == 3
            sConf5 := "Reg"
    if shortConfStack
        sConfHits += 1
        if sConfHits == 1
            sConf3 := "Stack"
        else if sConfHits == 2
            sConf4 := "Stack"
        else if sConfHits == 3
            sConf5 := "Stack"
    if shortConfPrice
        sConfHits += 1
        if sConfHits == 1
            sConf3 := "Price"
        else if sConfHits == 2
            sConf4 := "Price"
        else if sConfHits == 3
            sConf5 := "Price"
    if shortConfStructure
        sConfHits += 1
        if sConfHits == 1
            sConf3 := "Struct"
        else if sConfHits == 2
            sConf4 := "Struct"
        else if sConfHits == 3
            sConf5 := "Struct"
    if shortConfFvg
        sConfHits += 1
        if sConfHits == 1
            sConf3 := "FVG"
        else if sConfHits == 2
            sConf4 := "FVG"
        else if sConfHits == 3
            sConf5 := "FVG"
    if shortConfAdx
        sConfHits += 1
        if sConfHits == 1
            sConf3 := "ADX"
        else if sConfHits == 2
            sConf4 := "ADX"
        else if sConfHits == 3
            sConf5 := "ADX"
    if shortConfBias
        sConfHits += 1
        if sConfHits == 1
            sConf3 := "Bias"
        else if sConfHits == 2
            sConf4 := "Bias"
        else if sConfHits == 3
            sConf5 := "Bias"
    if shortConfCtx
        sConfHits += 1
        if sConfHits == 1
            sConf3 := "Ctx"
        else if sConfHits == 2
            sConf4 := "Ctx"
        else if sConfHits == 3
            sConf5 := "Ctx"

    // First 3 blockers (ordered, first-hit priority)
    string lBlk1 = "-"
    string lBlk2 = "-"
    string lBlk3 = "-"
    int lBlkN = 0
    if not longTplOk
        lBlkN += 1
        if lBlkN == 1
            lBlk1 := "Template"
        else if lBlkN == 2
            lBlk2 := "Template"
        else if lBlkN == 3
            lBlk3 := "Template"
    if not useLong
        lBlkN += 1
        if lBlkN == 1
            lBlk1 := "LongDisabled"
        else if lBlkN == 2
            lBlk2 := "LongDisabled"
        else if lBlkN == 3
            lBlk3 := "LongDisabled"
    if strategy.position_size > 0
        lBlkN += 1
        if lBlkN == 1
            lBlk1 := "InLong"
        else if lBlkN == 2
            lBlk2 := "InLong"
        else if lBlkN == 3
            lBlk3 := "InLong"
    if shortSignal
        lBlkN += 1
        if lBlkN == 1
            lBlk1 := "OppSignal"
        else if lBlkN == 2
            lBlk2 := "OppSignal"
        else if lBlkN == 3
            lBlk3 := "OppSignal"

    string sBlk1 = "-"
    string sBlk2 = "-"
    string sBlk3 = "-"
    int sBlkN = 0
    if not shortTplOk
        sBlkN += 1
        if sBlkN == 1
            sBlk1 := "Template"
        else if sBlkN == 2
            sBlk2 := "Template"
        else if sBlkN == 3
            sBlk3 := "Template"
    if not useShort
        sBlkN += 1
        if sBlkN == 1
            sBlk1 := "ShortDisabled"
        else if sBlkN == 2
            sBlk2 := "ShortDisabled"
        else if sBlkN == 3
            sBlk3 := "ShortDisabled"
    if strategy.position_size < 0
        sBlkN += 1
        if sBlkN == 1
            sBlk1 := "InShort"
        else if sBlkN == 2
            sBlk2 := "InShort"
        else if sBlkN == 3
            sBlk3 := "InShort"
    if longSignal
        sBlkN += 1
        if sBlkN == 1
            sBlk1 := "OppSignal"
        else if sBlkN == 2
            sBlk2 := "OppSignal"
        else if sBlkN == 3
            sBlk3 := "OppSignal"

    // Long row
    table.cell(gateTbl, 0, 1, "Long", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 1, 1, f_gate_txt(canTrade), text_color=f_dbg_col(canTrade), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 2, 1, f_gate_txt(volatilityOkLong), text_color=f_dbg_col(volatilityOkLong), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 3, 1, f_gate_txt(longSROk), text_color=f_dbg_col(longSROk), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 4, 1, f_gate_txt(longMacdOk), text_color=f_dbg_col(longMacdOk), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 5, 1, f_gate_txt(longRsiOk), text_color=f_dbg_col(longRsiOk), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 6, 1, lConf3, text_color=lConf3 == "BLOCK" ? color.red : color.lime, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 7, 1, lConf4, text_color=lConf4 == "" ? color.gray : color.lime, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 8, 1, lConf5, text_color=lConf5 == "" ? color.gray : color.lime, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 9, 1, lBlk1, text_color=lBlk1 == "-" ? color.lime : color.red, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 10, 1, lBlk2, text_color=lBlk2 == "-" ? color.lime : color.red, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 11, 1, lBlk3, text_color=lBlk3 == "-" ? color.lime : color.red, text_size=size.tiny, bgcolor=color.new(color.black, 85))

    // Short row
    table.cell(gateTbl, 0, 2, "Short", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 1, 2, f_gate_txt(canTrade), text_color=f_dbg_col(canTrade), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 2, 2, f_gate_txt(volatilityOkShort), text_color=f_dbg_col(volatilityOkShort), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 3, 2, f_gate_txt(shortSROk), text_color=f_dbg_col(shortSROk), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 4, 2, f_gate_txt(shortMacdOk), text_color=f_dbg_col(shortMacdOk), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 5, 2, f_gate_txt(shortRsiOk), text_color=f_dbg_col(shortRsiOk), text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 6, 2, sConf3, text_color=sConf3 == "BLOCK" ? color.red : color.lime, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 7, 2, sConf4, text_color=sConf4 == "" ? color.gray : color.lime, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 8, 2, sConf5, text_color=sConf5 == "" ? color.gray : color.lime, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 9, 2, sBlk1, text_color=sBlk1 == "-" ? color.lime : color.red, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 10, 2, sBlk2, text_color=sBlk2 == "-" ? color.lime : color.red, text_size=size.tiny, bgcolor=color.new(color.black, 85))
    table.cell(gateTbl, 11, 2, sBlk3, text_color=sBlk3 == "-" ? color.lime : color.red, text_size=size.tiny, bgcolor=color.new(color.black, 85))
else
    for r = 1 to 2
        for c = 0 to 11
            table.cell(gateTbl, c, r, "", text_color=color.black, text_size=size.tiny, bgcolor=color.new(color.black, 100))
